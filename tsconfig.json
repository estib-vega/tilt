{
  "files": [],
  "references": [
    { "path": "./tsconfig.ui.json" },
    { "path": "./tsconfig.electron.json" }
  ],
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/ui/*"],
      "@api/*": ["./src/electron/*"]
    }
  }
}
