{
  "name": "tilt",
  "private": true,
  "version": "0.1.0",
  "author": {
    "name": "estib",
    "email": "stron@me.com"
  },
  "description": "tilt: the knowledge management application",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:ui": "vite --port 3000",
    "dev:electron": "NODE_ENV=development electron . --trace-warnings",
    "build:ui": "vite build && tsc",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm run build:ui && pnpm run build:electron",
    "clean-bundle": "rm -rf dist",
    "bundle:dev": "pnpm run clean-bundle && pnpm run build && DEBUG=true electron-builder --config src/electron/scripts/electron-builder.js",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint --config eslint.config.js",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint --config eslint.config.js --fix",
    "fix": "pnpm run fix:format && pnpm run fix:lint",
    "check": "prettier --check . && pnpm lint && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.33",
    "@ai-sdk/openai": "^3.0.23",
    "@ai-sdk/react": "^3.0.66",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@tiptap/markdown": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "ai": "^6.0.64",
    "better-sqlite3": "^12.5.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "ollama": "^0.6.3",
    "ollama-ai-provider-v2": "^3.0.3",
    "puppeteer-core": "^24.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-flip-toolkit": "^7.2.4",
    "shiki": "^3.17.1",
    "streamdown": "^1.6.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.3.6",
    "use-stick-to-bottom": "^1.1.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.1",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.18",
    "electron": "^39.2.3",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
